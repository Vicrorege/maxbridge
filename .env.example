# Номер телефона аккаунта MAX в международном формате.
PHONE=

# Токен Telegram-бота от BotFather.
BOT_TOKEN=

# Telegram ID администратора (по умолчанию ваш ID: 1678840203), только он может выполнять команды и привязку
ADMIN_TG_ID=1678840203

# SOCKS5/HTTP-прокси только для Telegram Bot API. Max всегда идёт напрямую.
# Примеры:
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_PROXY=socks5://user:pass@host:1080
TELEGRAM_PROXY=

# true — пересылать сообщения из Telegram в MAX, false — не пересылать (рекомендуется false).
FORWARD_TG_TO_MAX=false

# ==============================================================================
# РЕЖИМ 1: Общий мост (все чаты MAX в один Telegram-чат)
# ==============================================================================
# ID целевого Telegram-чата (группа, канал или ЛС), куда будут приходить
# все сообщения из всех чатов MAX. Можно привязать на лету командой /bind в группе.
COMMON_TG_CHAT=

# Список исключений MAX-чатов (ID чатов через запятую или JSON-список),
# сообщения из которых НЕ будут пересылаться в Telegram.
# Пример: EXCLUDE_MAX_CHATS=-10000000000000, -20000000000000
# Также можно управлять на лету командами бота в Telegram: /exclude <id>, /include <id>, /chats
EXCLUDE_MAX_CHATS=

# Показывать ли префикс с названием чата [Название чата] перед автором (true/false)
SHOW_CHAT_TITLE=true

# ==============================================================================
# РЕЖИМ 2: 1-в-1 мост (индивидуальная привязка MAX -> TG)
# ==============================================================================
# JSON-словарь: "id чата MAX" -> id чата Telegram.
# Если задан COMMON_TG_CHAT, чаты из CHATS идут в свои TG-чаты, а остальные — в COMMON_TG_CHAT.
# Пример:
# CHATS={"-10000000000000": -1000000000000}
CHATS=
